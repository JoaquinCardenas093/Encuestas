[Unit]
Description=adnanh webhook - Aurum auto-deploy on push to main
After=network.target docker.service
Wants=docker.service

[Service]
# Secret lives here, NOT in the repo. Create it on the server (see DEPLOY.md):
#   /etc/aurum-webhook.env  ->  GITHUB_WEBHOOK_SECRET=<your secret>
EnvironmentFile=/etc/aurum-webhook.env
ExecStart=/usr/bin/webhook -hooks /opt/aurum/deploy/hooks.json -template -ip 0.0.0.0 -port 9000 -verbose
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
